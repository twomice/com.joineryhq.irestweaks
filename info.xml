<?xml version="1.0"?>
<extension key="com.joineryhq.irestweaks" type="module">
  <file>irestweaks</file>
  <name>IRES Tweaks</name>
  <description>Custom behaviors for IRES</description>
  <license>GPL-3.0</license>
  <maintainer>
    <author>Allen Shaw</author>
    <email>allen@JoineryHQ.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/twomice/com.joineryhq.irestweaks/</url>
    <url desc="Documentation">https://github.com/twomice/com.joineryhq.irestweaks/</url>
    <url desc="Support">https://github.com/twomice/com.joineryhq.irestweaks/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/gpl-3.0.html</url>
  </urls>
  <releaseDate>2020-08-27</releaseDate>
  <version>1.0.1</version>
  <develStage>prof</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments>Allows modifying the contribution Source field based on the 'source' query string parameter, if such is provided in the URL for a contribution page.</comments>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
    <psr0 prefix="CRM_" path="."/>
  </classloader>
  <civix>
    <namespace>CRM/Irestweaks</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
</extension>
